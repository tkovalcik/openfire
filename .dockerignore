# VCS and editor noise
.git
.gitignore
.DS_Store
.vscode
.idea

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local environments
.venv/
venv/
env/
.env
.env.*

# Tests and local docs are not needed in runtime images.
tests/

