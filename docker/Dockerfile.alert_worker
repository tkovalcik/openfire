FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY docker/requirements.ui_socal.txt /tmp/requirements.ui_socal.txt
RUN pip install --no-cache-dir -r /tmp/requirements.ui_socal.txt

COPY src/ /app/src/

RUN useradd --create-home --uid 10001 appuser
USER appuser

CMD ["python", "-m", "src.ui_socal.alert_worker"]
