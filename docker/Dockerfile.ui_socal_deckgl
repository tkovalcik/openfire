FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENFIRE_SOCAL_STATIC_ROOT=/app/frontend-socal-deckgl \
    OPENFIRE_UI_VARIANT=deckgl-scatterplot

WORKDIR /app

COPY docker/requirements.ui_socal.txt /tmp/requirements.ui_socal.txt
RUN pip install --no-cache-dir -r /tmp/requirements.ui_socal.txt

COPY src/ /app/src/
COPY frontend-socal-deckgl/ /app/frontend-socal-deckgl/

RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8080

CMD ["uvicorn", "src.ui_socal.app:app", "--host", "0.0.0.0", "--port", "8080"]
